{
    "description": "DINOv3-B for PSG, but I'm using the neg_ratio from the original experiments. Also, the backbone is trained.",
    "loss": {
        "rel_weight": 0.8,
        "node_loss_weight": 0.2,
        "angle_weight": 0.15,
        "distance_weight": 0.1,
        "legacy_balancing": true
    },
    "rels_per_batch": 512,
    "lr": 1e-05,
    "weight_decay": 0.04,
    "neg_ratio": 1.0,
    "ema": 0.995,
    "augmentations": {
        "train": [
            "ToTensor",
            "ClampBoundingBoxes",
            "RandomHorizontalFlip",
            "SquarePad",
            {
                "@": "Resize",
                "size": 640
            },
            {
                "@": "ColorJitter",
                "brightness": 0.1,
                "contrast": 0.1,
                "saturation": 0.1,
                "hue": 0.1
            },
            {
                "@": "NormalizeFor",
                "stats": "imagenet"
            }
        ],
        "val": [
            "ToTensor",
            "ClampBoundingBoxes",
            "SquarePad",
            {
                "@": "Resize",
                "size": 640
            },
            {
                "@": "NormalizeFor",
                "stats": "imagenet"
            }
        ]
    },
    "extractor": {
        "type": "dinov3",
        "variant": "vits16",
        "frozen": false
    },
    "architecture": {
        "transformer_depth": 6,
        "embed_dim": 384,
        "patch_size": 3,
        "use_semantics": true,
        "use_masks": true,
        "bg_ratio_strategy": "sum",
        "encode_coords": true
    },
    "data": {
        "source": "psg"
    }
}